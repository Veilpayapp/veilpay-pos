[Unit]
Description=VeilPay POS Frontend Server
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/veilpay-pos/frontend
ExecStart=/usr/bin/npx serve dist -s -p 5173
EnvironmentFile=/home/pi/veilpay-pos/.env
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
